console_log() {
    local lines=20
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --lines)
                if [[ $# -lt 2 || ! ${2-} =~ ^[0-9]+$ ]]; then
                    __bashcmdr_error "--lines requires a nonnegative integer"
                    return 1
                fi
                lines="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    local log_file="$BASHCMDR_ROOT/logs/console-poweron.log"
    if [[ ! -f "$log_file" ]]; then
        __bashcmdr_info "No log file found"
        return 0
    fi

    echo "=== Console Log (last $lines lines) ==="
    echo
    tail -n "$lines" "$log_file"
}

# Preserve shell commands unless the documented force setting is enabled.
setup_bcm_alias() {
    if [[ ${BASHCMDR_FORCE_BCM_ALIAS-} == 1 ]]; then
        alias bcm='bashcmdr'
        return
    fi
    # Query aliases directly, including shells with expansion disabled.
    alias bcm >/dev/null 2>&1 && return 0
    local existing
    existing=$(type -P bcm) || existing=''
    if ! declare -f bcm >/dev/null 2>&1 && [[ -n "$existing" && "$existing" -ef "$BASHCMDR_CONSOLE_EXE" ]]; then
        return 0  # Our own executable is already usable; no alias is necessary.
    fi
    if command -v bcm >/dev/null 2>&1 || declare -f bcm >/dev/null 2>&1; then
        __bashcmdr_info "Preserving existing 'bcm' command or function"
        __bashcmdr_info "To shadow it explicitly, set BASHCMDR_FORCE_BCM_ALIAS=1 before boot"
        return 1
    fi
    alias bcm='bashcmdr'
    return
}

# ═══════════════════════════════════════════════════════════════
#  Cartridge Commands — bcm cartridge <verb>
# ═══════════════════════════════════════════════════════════════

cartridge_dispatch() {
    local verb="${1:-}"
    shift 2>/dev/null || true

    if [[ -z "$verb" || "$verb" =~ ^(-h|--help|help)$ ]]; then
        help_cartridge
        return 0
    fi

    # Intercept --help/-h on any verb: bcm cartridge <verb> --help
    if [[ "${1:-}" =~ ^(-h|--help)$ ]]; then
        help_verb cartridge "$verb"
        return
    fi

    case "$verb" in
        # Installation
        install)
            if [[ -z "${1:-}" ]]; then
                __bashcmdr_error "Usage: bcm cartridge install <name> [--from <url>]"
                return 1
            fi
            cartridge_install_cmd "$@"
            ;;
        uninstall)
            if [[ -z "${1:-}" ]]; then
                __bashcmdr_error "Usage: bcm cartridge uninstall <name> [--purge]"
                return 1
            fi
            cartridge_uninstall_cmd "$@"
            ;;
        upgrade)
            if [[ -z "${1:-}" ]]; then
                __bashcmdr_error "Usage: bcm cartridge upgrade <name> | --all"
                return 1
            fi
            cartridge_upgrade_cmd "$@"
            ;;
        # Activation
        plug)
            if [[ -z "${1:-}" ]]; then
                __bashcmdr_error "Usage: bcm cartridge plug <name>"
                return 1
            fi
            bashcmdr_plug_cartridge "$1"
            ;;
        unplug)
            if [[ -z "${1:-}" ]]; then
                __bashcmdr_error "Usage: bcm cartridge unplug <name>"
                return 1
            fi
            bashcmdr_unplug_cartridge "$1"
            ;;
        quarantine)
            if [[ -z "${1:-}" ]]; then
                __bashcmdr_error "Usage: bcm cartridge quarantine <name> [reason]"
                return 1
            fi
            bashcmdr_quarantine_cartridge "$1" "${2:-Manual quarantine}"
            ;;
        release)
            if [[ -z "${1:-}" ]]; then
                __bashcmdr_error "Usage: bcm cartridge release <name>"
                return 1
            fi
            bashcmdr_release_cartridge "$1"
            ;;
        # Discovery
        show)
            if [[ -z "${1:-}" ]]; then
                __bashcmdr_error "Usage: bcm cartridge show <name>"
                return 1
            fi
            cartridge_show_cmd "$1"
            ;;
        list)
            cartridge_list_cmd "${1:-all}"
            ;;
        search)
            cartridge_search_cmd "$@"
            ;;
        # Analysis
        deps)
            if [[ -z "${1:-}" ]]; then
                __bashcmdr_error "Usage: bcm cartridge deps <name>"
                return 1
            fi
            cartridge_deps_cmd "$1"
            ;;
        plan)
            if [[ -z "${1:-}" ]]; then
                __bashcmdr_error "Usage: bcm cartridge plan <name>"
                return 1
            fi
            cartridge_plan_cmd "$1"
            ;;
        graph)
            if [[ -z "${1:-}" ]]; then
                __bashcmdr_error "Usage: bcm cartridge graph <name>"
                return 1
            fi
            cartridge_graph_cmd "$1"
            ;;
        why)
            if [[ -z "${1:-}" ]]; then
                __bashcmdr_error "Usage: bcm cartridge why <name>"
                return 1
            fi
            cartridge_why_cmd "$1"
            ;;
        diagnose)
            if [[ -z "${1:-}" ]]; then
                __bashcmdr_error "Usage: bcm cartridge diagnose <name>"
                return 1
            fi
            cartridge_diagnose_cmd "$1"
            ;;
        *)
            __bashcmdr_error "Unknown cartridge verb: $verb"
            __bashcmdr_info "Try: bcm help cartridge"
            return 1
            ;;
    esac
}

# --- Cartridge: Installation ---

cartridge_install_cmd() {
    local cartridge="" git_url=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from)
                if [[ -z "${2:-}" ]]; then
                    __bashcmdr_error "--from requires a Git URL"
                    return 1
                fi
                git_url="$2"; shift 2 ;;
            --from=*)
                git_url="${1#--from=}"
                if [[ -z "$git_url" ]]; then
                    __bashcmdr_error "--from requires a Git URL"
                    return 1
                fi
                shift ;;
            -*)
                __bashcmdr_error "Unknown option: $1"
                return 1
                ;;
            *)
                if [[ -n "$cartridge" ]]; then
                    __bashcmdr_error "Unexpected argument: $1"
                    return 1
                fi
                __bashcmdr_validate_cartridge_name "$1" || return 1
                cartridge="$1"; shift ;;
        esac
    done

    if [[ -z "$cartridge" && -z "$git_url" ]]; then
        __bashcmdr_error "Usage: bcm cartridge install <name> [--from <url>]"
        return 1
    fi

    __bashcmdr_require_tool jq 'cartridge install' || return 1
    __bashcmdr_require_tool git 'cartridge install' || return 1
    echo "=== Installing Cartridge: ${cartridge:-$git_url} ==="

    if [[ -n "$cartridge" ]] && bashcmdr_is_installed "$cartridge"; then
        __bashcmdr_error "Cartridge already installed: $cartridge"
        return 1
    fi

    # --from is authoritative: only fall back to the registry without it
    if [[ -z "$git_url" ]]; then
        local version
        version=$(bashcmdr_get_registry_version "$cartridge")

        if [[ -z "$version" || "$version" == "null" ]]; then
            __bashcmdr_error "Cartridge not found in registry: $cartridge"
            echo "Install from Git with: bcm cartridge install $cartridge --from <url>"
            return 1
        fi

        git_url=$(bashcmdr_get_cartridge_info "$cartridge" ".repository")
        if [[ -z "$git_url" || "$git_url" == "null" ]]; then
            __bashcmdr_error "No Git URL provided or found in registry"
            return 1
        fi
    fi

    if [[ "$git_url" == -* || "$git_url" == *[[:cntrl:]]* ]]; then
        __bashcmdr_error 'Invalid Git source operand: use a URL or path without a leading dash or control characters'
        return 1
    fi
    local clone_protocols='https:http:ssh:git:file' clone_protocol
    if [[ ${GIT_ALLOW_PROTOCOL+x} ]]; then
        clone_protocols=''
        for clone_protocol in https http ssh git file; do
            if [[ ":$GIT_ALLOW_PROTOCOL:" == *":$clone_protocol:"* ]]; then
                clone_protocols+="${clone_protocols:+:}$clone_protocol"
            fi
        done
    fi
    if [[ -z "$clone_protocols" ]]; then
        __bashcmdr_error 'Git transport policy permits no supported protocols; clone was not attempted'
        return 1
    fi
    echo "Fetching from: $git_url"

    local temp_dir
    temp_dir=$(mktemp -d) || return 1
    # shellcheck disable=SC2064  # expand temp_dir now; the local is gone when RETURN fires
    trap "rm -rf '$temp_dir'; trap - RETURN" RETURN

    local src="$temp_dir/src"
    # Bound Git's final transport choice, including configured URL rewrites.
    # This selects transports; it does not authenticate or sandbox cartridge code.
    if ! GIT_ALLOW_PROTOCOL="$clone_protocols" git clone --quiet -- "$git_url" "$src"; then
        __bashcmdr_error "Failed to clone repository: $git_url"
        return 1
    fi

    local manifest="$src/manifest.json"
    if [[ ! -f "$manifest" ]]; then
        __bashcmdr_error "Cartridge manifest not found in repository"
        return 1
    fi

    # The manifest names the cartridge
    local manifest_name
    manifest_name=$(jq -r '.name // empty' "$manifest" 2>/dev/null)
    __bashcmdr_validate_cartridge_name "$manifest_name" || return 1
    if [[ -n "$cartridge" && "$cartridge" != "$manifest_name" ]]; then
        __bashcmdr_error "Manifest names '$manifest_name', not '$cartridge'"
        return 1
    fi
    cartridge="$manifest_name"

    if bashcmdr_is_installed "$cartridge"; then
        __bashcmdr_error "Cartridge already installed: $cartridge"
        return 1
    fi

    local installed_commit
    if ! installed_commit=$(git -C "$src" rev-parse --verify 'HEAD^{commit}') ||
       [[ ! "$installed_commit" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]]; then
        __bashcmdr_error 'Cannot record cloned commit; refusing installation without provenance'
        return 1
    fi

    echo "Checking dependencies..."
    local deps
    deps=$(jq -r '.requires.cartridges // {} | keys[]' "$manifest" 2>/dev/null)
    local missing_deps=()

    for dep in $deps; do
        if ! bashcmdr_is_installed "$dep"; then
            missing_deps+=("$dep")
        fi
    done

    if [[ ${#missing_deps[@]} -gt 0 ]]; then
        __bashcmdr_error "Missing dependencies: ${missing_deps[*]}"
        echo "Install them with: bcm cartridge install ${missing_deps[*]}"
        return 1
    fi

    if [[ -n "$deps" ]]; then
        __bashcmdr_success "Dependencies satisfied"
    fi

    echo "Installing to: $BASHCMDR_INSTALLED_DIR/$cartridge"
    mkdir -p "$BASHCMDR_INSTALLED_DIR" || return 1
    # Keep the clone (including .git) so the cartridge stays a managed checkout
    if ! mv "$src" "$BASHCMDR_INSTALLED_DIR/$cartridge"; then
        __bashcmdr_error "Failed to install into $BASHCMDR_INSTALLED_DIR/$cartridge"
        return 1
    fi

    if ! bashcmdr_save_cartridge_metadata "$cartridge" "$git_url" "$installed_commit" "$clone_protocols"; then
        __bashcmdr_error "Package installed but metadata recording failed: $cartridge"
        return 1
    fi

    __bashcmdr_success "Cartridge installed: $cartridge"
    echo "Activate it with: bcm cartridge plug $cartridge"
}

__bashcmdr_uninstall_check_dependents() {
    local __bcm_un_dependent_text __bcm_un_dependent
    local -a __bcm_un_dependents=()
    if ! __bcm_un_dependent_text=$(bashcmdr_get_dependents "$1"); then
        __bashcmdr_error 'Installed dependency inspection failed; refusing uninstall'; return 1
    fi
    [[ -z "$__bcm_un_dependent_text" ]] || mapfile -t __bcm_un_dependents <<< "$__bcm_un_dependent_text"
    for __bcm_un_dependent in "${__bcm_un_dependents[@]}"; do
        __bashcmdr_validate_cartridge_name "$__bcm_un_dependent" || return 1
    done
    if ((${#__bcm_un_dependents[@]})); then
        __bashcmdr_error "Cannot uninstall: installed dependents: ${__bcm_un_dependents[*]}"; return 1
    fi
}

__bashcmdr_uninstall_read_state() {
    local __bcm_un_name="$1" __bcm_un_state_dir __bcm_un_link
    # shellcheck disable=SC2178 # Nameref binds a caller-owned associative array.
    local -n __bcm_un_state_output="$2"
    __bcm_un_state_output=()
    for __bcm_un_state_dir in active inactive broken quarantine; do
        __bcm_un_link="$BASHCMDR_ROOT/console/$__bcm_un_state_dir/$__bcm_un_name"
        if [[ -L "$__bcm_un_link" ]]; then
            __bcm_un_state_output["$__bcm_un_state_dir"]=$(readlink "$__bcm_un_link") || return 1
        elif [[ -e "$__bcm_un_link" ]]; then
            __bashcmdr_error "Foreign non-symlink state entry: $__bcm_un_link"; return 1
        fi
    done
}

__bashcmdr_uninstall_check_state() {
    local __bcm_un_check_name="$1" __bcm_un_check_state
    local -n __bcm_un_expected_state="$2"
    local -A __bcm_un_current_state=()
    __bashcmdr_uninstall_read_state "$__bcm_un_check_name" __bcm_un_current_state || return 1
    for __bcm_un_check_state in active inactive broken quarantine; do
        if [[ ${__bcm_un_expected_state[$__bcm_un_check_state]+set} != "${__bcm_un_current_state[$__bcm_un_check_state]+set}" ||
              ${__bcm_un_expected_state[$__bcm_un_check_state]-} != "${__bcm_un_current_state[$__bcm_un_check_state]-}" ]]; then
            __bashcmdr_error 'State changed during uninstall; refusing to overwrite the new choice'; return 1
        fi
    done
}

__bashcmdr_uninstall_check_caches() {
    local __bcm_un_cache_name __bcm_un_cache_decl
    for __bcm_un_cache_name in BASHCMDR_CARTRIDGES_STATE BASHCMDR_CARTRIDGES_PATHS; do
        __bcm_un_cache_decl=$(declare -p "$__bcm_un_cache_name" 2>/dev/null) || continue
        __bcm_un_cache_decl="${__bcm_un_cache_decl#declare -}"; __bcm_un_cache_decl="${__bcm_un_cache_decl%% *}"
        if [[ "$__bcm_un_cache_decl" == *r* || "$__bcm_un_cache_decl" != *A* ]]; then
            __bashcmdr_error 'Cannot reconcile locked or incompatible cartridge cache'; return 1
        fi
    done
}

__bashcmdr_uninstall_update_caches() {
    local __bcm_un_cache_target="$1" __bcm_un_cache_root="$2" __bcm_un_cache_state
    __bashcmdr_uninstall_check_caches || return 1
    if declare -p BASHCMDR_CARTRIDGES_PATHS &>/dev/null; then
        unset 'BASHCMDR_CARTRIDGES_PATHS[$__bcm_un_cache_target]' || return 1
    fi
    if declare -p BASHCMDR_CARTRIDGES_STATE &>/dev/null; then
        unset 'BASHCMDR_CARTRIDGES_STATE[$__bcm_un_cache_target]' || return 1
        for __bcm_un_cache_state in quarantine active broken inactive; do
            if [[ -L "$__bcm_un_cache_root/console/$__bcm_un_cache_state/$__bcm_un_cache_target" ]]; then
                BASHCMDR_CARTRIDGES_STATE["$__bcm_un_cache_target"]="$__bcm_un_cache_state"
                break
            fi
        done
    fi
}

cartridge_uninstall_cmd() {
    local __bcm_un_name="${1-}" __bcm_un_purge="${2-}"
    __bashcmdr_validate_cartridge_name "$__bcm_un_name" || return 1
    if (($# > 2)) || [[ -n "$__bcm_un_purge" && "$__bcm_un_purge" != --purge ]]; then
        __bashcmdr_error 'Usage: bcm cartridge uninstall <name> [--purge]'; return 1
    fi
    if [[ -z ${BASHCMDR_ROOT:-} ]]; then local BASHCMDR_ROOT="${BASHCMDR_ROOT_DIR:-}"; fi
    local __bcm_un_target __bcm_un_root __bcm_un_installed_root
    local __bcm_un_workdir="$PWD" __bcm_un_root_setting="${BASHCMDR_ROOT-}" __bcm_un_installed_setting="${BASHCMDR_INSTALLED_DIR-}" __bcm_un_metadata_setting="${BASHCMDR_REGISTRY_METADATA-}"
    local __bcm_un_state __bcm_un_physical
    local -A __bcm_un_prior_state=()
    if [[ -z ${BASHCMDR_ROOT:-} || -z ${BASHCMDR_INSTALLED_DIR:-} || -z ${BASHCMDR_REGISTRY_METADATA:-} || ! "$BASHCMDR_INSTALLED_DIR" -ef "$BASHCMDR_ROOT/cartridges" || -L "$BASHCMDR_INSTALLED_DIR" ]]; then
        __bashcmdr_error 'Installed directory does not match the selected console root'; return 1
    fi
    __bcm_un_root=$(CDPATH='' builtin cd -P -- "$BASHCMDR_ROOT" && builtin pwd -P) || return 1
    __bcm_un_installed_root=$(CDPATH='' builtin cd -P -- "$BASHCMDR_INSTALLED_DIR" && builtin pwd -P) || return 1
    __bcm_un_target="$__bcm_un_installed_root/$__bcm_un_name"
    if [[ ! -d "$__bcm_un_target" || -L "$__bcm_un_target" ]]; then
        __bashcmdr_error "Cartridge is not an ordinary installed directory: $__bcm_un_name"; return 1
    fi
    __bashcmdr_uninstall_check_dependents "$__bcm_un_name" || return 1
    __bashcmdr_uninstall_read_state "$__bcm_un_name" __bcm_un_prior_state || return 1
    for __bcm_un_state in active inactive broken; do
        if [[ ${__bcm_un_prior_state[$__bcm_un_state]+set} && ! "$BASHCMDR_ROOT/console/$__bcm_un_state/$__bcm_un_name" -ef "$__bcm_un_target" ]]; then
            __bashcmdr_error "State link does not refer to installed cartridge: $__bcm_un_state/$__bcm_un_name"; return 1
        fi
    done
    if [[ ! ${__bcm_un_prior_state[quarantine]+set} ]]; then
        __bashcmdr_get_physical_cartridge_state "$__bcm_un_name" __bcm_un_physical || return 1
    fi
    __bashcmdr_validate_installed_metadata "$__bcm_un_name" || return 1
    __bashcmdr_uninstall_check_caches || return 1
    if [[ ${__bcm_un_prior_state[active]+set} && ! ${__bcm_un_prior_state[quarantine]+set} ]]; then
        if ! __bashcmdr_cartridge_call "$__bcm_un_name" deactivate; then
            __bashcmdr_error 'Uninstall deactivation failed; package removal did not start'; return 1
        fi
        if [[ ${BASHCMDR_ROOT-} != "$__bcm_un_root_setting" || ${BASHCMDR_INSTALLED_DIR-} != "$__bcm_un_installed_setting" || ${BASHCMDR_REGISTRY_METADATA-} != "$__bcm_un_metadata_setting" ]]; then
            __bashcmdr_error 'Uninstall storage configuration changed during deactivation; package retained'; return 1
        fi
        # Trusted deactivation can change choices or installed dependencies.
        (CDPATH='' builtin cd -- "$__bcm_un_workdir" && __bashcmdr_uninstall_check_state "$__bcm_un_name" __bcm_un_prior_state) || return 1
        (CDPATH='' builtin cd -- "$__bcm_un_workdir" && __bashcmdr_uninstall_check_dependents "$__bcm_un_name") || return 1
        (CDPATH='' builtin cd -- "$__bcm_un_workdir" && __bashcmdr_validate_installed_metadata "$__bcm_un_name") || return 1
        __bashcmdr_uninstall_check_caches || return 1
    fi
    printf 'Removing installed cartridge: %s\n' "$__bcm_un_name"
    if ! rm -rf -- "${__bcm_un_target:?}"; then
        __bashcmdr_error 'Package removal failed; inspect remaining package/state before retrying'; return 1
    fi
    if [[ -e "$__bcm_un_target" || -L "$__bcm_un_target" ]]; then
        __bashcmdr_error 'Package removal did not remove the installed path'; return 1
    fi
    __bashcmdr_uninstall_update_caches "$__bcm_un_name" "$__bcm_un_root" || return 1
    (CDPATH='' builtin cd -- "$__bcm_un_workdir" && __bashcmdr_uninstall_check_state "$__bcm_un_name" __bcm_un_prior_state) || return 1
    for __bcm_un_state in active inactive broken quarantine; do
        [[ ${__bcm_un_prior_state[$__bcm_un_state]+set} ]] || continue
        [[ "$__bcm_un_state" != quarantine || "$__bcm_un_purge" == --purge ]] || continue
        if ! rm -- "$__bcm_un_root/console/$__bcm_un_state/$__bcm_un_name"; then
            __bashcmdr_uninstall_update_caches "$__bcm_un_name" "$__bcm_un_root" || true
            __bashcmdr_error 'Package removed but state cleanup failed; inspect retained marker'; return 1
        fi
        if [[ -e "$__bcm_un_root/console/$__bcm_un_state/$__bcm_un_name" || -L "$__bcm_un_root/console/$__bcm_un_state/$__bcm_un_name" ]]; then
            __bashcmdr_uninstall_update_caches "$__bcm_un_name" "$__bcm_un_root" || true
            __bashcmdr_error 'Package removed but state marker remains'; return 1
        fi
    done
    __bashcmdr_uninstall_update_caches "$__bcm_un_name" "$__bcm_un_root" || return 1
    if ! (CDPATH='' builtin cd -- "$__bcm_un_workdir" && bashcmdr_remove_cartridge_metadata "$__bcm_un_name"); then
        __bashcmdr_error 'Package removed but installed metadata cleanup failed'; return 1
    fi
    __bashcmdr_success "Cartridge uninstalled: $__bcm_un_name"
    return 0
}

cartridge_upgrade_cmd() {
    # TODO: Phase 2
    __bashcmdr_error "bcm cartridge upgrade is not yet implemented"
    __bashcmdr_info "This feature is planned for Phase 2"
    return 1
}

# --- Cartridge: Discovery ---

cartridge_show_cmd() {
    local cartridge="$1"

    local manifest_file="$BASHCMDR_INSTALLED_DIR/$cartridge/manifest.json"
    local source="registry"
    local json

    if [[ "$cartridge" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && -d "$BASHCMDR_INSTALLED_DIR/$cartridge" ]]; then
        if ! json=$(jq -es 'if length == 1 and (.[0] | type) == "object" then .[0] else error("invalid manifest") end' "$manifest_file" 2>/dev/null); then
            __bashcmdr_error "Cannot read installed manifest: $cartridge"
            return 1
        fi
        source="installed"
    else
        bashcmdr_load_registry_index || return 1
        if ! json=$(jq -e --arg name "$cartridge" '.cartridges[$name]' "$BASHCMDR_REGISTRY_INDEX" 2>/dev/null) || [[ -z "$json" || "$json" == "null" ]]; then
            __bashcmdr_error "Cartridge '$cartridge' not found in registry or installed cartridges"
            return 1
        fi
    fi

    local status
    status=$(bashcmdr_get_cartridge_status "$cartridge")
    [[ -z "$status" ]] && status="not installed"

    local name version description author license repository
    name=$(jq -r --arg name "$cartridge" '.name // $name' <<< "$json")
    version=$(jq -r '.version // "unknown"' <<< "$json")
    description=$(jq -r '.description // "none"' <<< "$json")
    author=$(jq -r '.author // "unknown"' <<< "$json")
    license=$(jq -r '.license // "not specified"' <<< "$json")
    repository=$(jq -r '.repository // "none"' <<< "$json")

    echo "=== Cartridge: $name ==="
    echo
    printf "  %-16s %s\n" "Version:" "$version"
    printf "  %-16s %s\n" "Status:" "$status"
    printf "  %-16s %s\n" "Description:" "$description"
    printf "  %-16s %s\n" "Author:" "$author"
    printf "  %-16s %s\n" "License:" "$license"
    printf "  %-16s %s\n" "Repository:" "$repository"
    printf "  %-16s %s\n" "Source:" "$source"

    local tags
    tags=$(jq -r '.tags // [] | join(", ")' <<< "$json" 2>/dev/null)
    if [[ -n "$tags" ]]; then
        printf "  %-16s %s\n" "Tags:" "$tags"
    fi

    local console_req
    console_req=$(jq -r '.requires.bashcmdr // empty' <<< "$json" 2>/dev/null)
    if [[ -n "$console_req" ]]; then
        echo
        echo "  Requirements:"
        printf "    %-14s %s\n" "bashcmdr:" "$console_req"
    fi

    local cart_deps
    cart_deps=$(echo "$json" | jq -r '.requires.cartridges // {} | to_entries[] | "    \(.key): \(.value)"' 2>/dev/null)
    if [[ -n "$cart_deps" ]]; then
        [[ -z "$console_req" ]] && echo && echo "  Requirements:"
        echo "$cart_deps" | while IFS= read -r dep; do
            echo "$dep"
        done
    fi

    local ext_deps
    ext_deps=$(echo "$json" | jq -r '.dependencies.external // {} | to_entries[]' 2>/dev/null)
    if [[ -n "$ext_deps" ]]; then
        echo
        echo "  External Dependencies:"
        echo "$json" | jq -r '.dependencies.external | to_entries[] | "    \(.key): \(.value.binary // "n/a") \(if .value.required then "(required)" else "(optional)" end)"' 2>/dev/null
    fi

    local commands functions environment
    commands=$(echo "$json" | jq -r '.provides.commands // [] | join(", ")' 2>/dev/null)
    functions=$(echo "$json" | jq -r '.provides.functions // [] | join(", ")' 2>/dev/null)
    environment=$(echo "$json" | jq -r '.provides.environment // [] | join(", ")' 2>/dev/null)

    if [[ -n "$commands" || -n "$functions" || -n "$environment" ]]; then
        echo
        echo "  Provides:"
        [[ -n "$commands" ]] && printf "    %-14s %s\n" "Commands:" "$commands"
        [[ -n "$environment" ]] && printf "    %-14s %s\n" "Environment:" "$environment"
        [[ -n "$functions" ]] && printf "    %-14s %s\n" "Functions:" "$functions"
    fi

    echo
}

cartridge_list_cmd() {
    local filter="${1:-all}"

    case "$filter" in
        all)
            bashcmdr_list_cartridges all | while read -r line; do
                if [[ "$line" =~ ^\=\=\= ]]; then
                    echo "$line"
                elif [[ "$line" =~ ^([^[:space:]]+)[[:space:]]+\[([^]]+)\]$ ]]; then
                    local name="${BASH_REMATCH[1]}"
                    local state="${BASH_REMATCH[2]}"
                    case "$state" in
                        active)     echo "  ✓ $name" ;;
                        inactive)   echo "  ○ $name" ;;
                        quarantine) echo "  ⚠ $name" ;;
                        broken)     echo "  ✗ $name" ;;
                        *)          echo "  ? $name [$state]" ;;
                    esac
                else
                    echo "$line"
                fi
            done
            ;;
        active|inactive|quarantine|broken)
            bashcmdr_list_cartridges "$filter"
            ;;
        outdated)
            # TODO: Phase 2
            __bashcmdr_info "bcm cartridge list outdated is not yet implemented"
            __bashcmdr_info "This feature is planned for Phase 2"
            return 0
            ;;
        *)
            __bashcmdr_error "Invalid filter: $filter"
            __bashcmdr_info "Valid filters: all, active, inactive, quarantine, broken, outdated"
            return 1
            ;;
    esac
}

# Local queries inspect ordinary installed directories, including manual installs.
# Buffer every row so an unreadable selected manifest cannot yield partial success.
__bashcmdr_search_local() {
    local keyword="$1" tag="$2" author="$3" active="$4" dir name row version desc
    local -a rows=()
    if ! jq -n --arg keyword "$keyword" --arg tag "$tag" --arg author "$author" '
        ("" | test($keyword; "i")) as $k |
        ("" | test($tag; "i")) as $t |
        ("" | test($author; "i"))' >/dev/null 2>&1; then
        __bashcmdr_error 'Invalid local search pattern'; return 1
    fi
    if [[ -e "$BASHCMDR_INSTALLED_DIR" && ! -d "$BASHCMDR_INSTALLED_DIR" ]]; then
        __bashcmdr_error 'Installed cartridge directory is unavailable'; return 1
    fi
    for dir in "$BASHCMDR_INSTALLED_DIR"/*; do
        [[ -d "$dir" && ! -L "$dir" ]] || continue
        name="${dir##*/}"
        __bashcmdr_validate_cartridge_name "$name" || return 1
        if [[ "$active" == 1 ]]; then
            [[ $(bashcmdr_get_cartridge_status "$name") == active &&
               "$BASHCMDR_ROOT/console/active/$name" -ef "$dir" ]] || continue
        fi
        if ! row=$(jq -ers --arg name "$name" --arg keyword "$keyword" --arg tag "$tag" --arg author "$author" '
            if length == 1 and (.[0] | type) == "object" then .[0] else error("invalid manifest") end
            | .version = (if .version == null then "unknown" else .version end)
            | .description = (if .description == null then "none" else .description end)
            | .author = (if .author == null then "unknown" else .author end)
            | .tags = (if .tags == null then [] else .tags end)
            | if (.version | type) != "string"
                 or (.description | type) != "string"
                 or (.author | type) != "string"
                 or (.tags | type) != "array"
              then error("invalid query fields") else . end
            | if all((.tags // [])[]; type == "string") then . else error("invalid tags") end
            | if (($name | test($keyword; "i")) or ((.description // "none") | test($keyword; "i"))
                  or any((.tags // [])[]; test($keyword; "i")) or ((.author // "unknown") | test($keyword; "i")))
                 and ($tag == "" or any((.tags // [])[]; test($tag; "i")))
                 and ((.author // "unknown") | test($author; "i"))
              then "\($name)\t\(.version // "unknown")\t\(.description // "none")" else "" end
        ' "$dir/manifest.json" 2>/dev/null); then
            __bashcmdr_error "Cannot search installed manifest: $name"; return 1
        fi
        [[ -z "$row" ]] || rows+=("$row")
    done
    if [[ "$active" == 1 ]]; then printf '=== Active Cartridges ===\n\n';
    else printf '=== Installed Cartridges ===\n\n'; fi
    for row in "${rows[@]}"; do
        IFS=$'\t' read -r name version desc <<< "$row"
        printf '  %-20s %-10s %s\n' "$name" "$version" "$desc"
    done
    return 0
}

cartridge_search_cmd() {
    local keyword=""
    local filter_tag=""
    local filter_author=""
    local filter_installed=0
    local filter_active=0

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tag|--author)
                if [[ $# -lt 2 || -z ${2-} ]]; then
                    __bashcmdr_error "$1 requires a value"
                    return 1
                fi
                if [[ "$1" == --tag ]]; then filter_tag="$2"; else filter_author="$2"; fi
                shift 2 ;;
            --installed) filter_installed=1; shift ;;
            --active)    filter_active=1; shift ;;
            *)           keyword="$1"; shift ;;
        esac
    done

    if ((filter_installed || filter_active)); then
        __bashcmdr_search_local "$keyword" "$filter_tag" "$filter_author" "$filter_active"
        return $?
    fi

    bashcmdr_load_registry_index || return 1

    # Dispatch to the appropriate filter
    if [[ -n "$filter_tag" ]]; then
        local results
        if ! results=$(jq -r --arg pattern "$filter_tag" '
            ("" | test($pattern; "i")) as $valid_pattern
            | .cartridges | to_entries[] | select(.value.tags[]? | test($pattern; "i"))
            | "\(.key)\t\(.value.version)\t\(.value.description)"
        ' "$BASHCMDR_REGISTRY_INDEX" 2>/dev/null); then
            __bashcmdr_error "Invalid tag search pattern or registry data"
            return 1
        fi
        echo "=== Cartridges with tag: $filter_tag ==="
        echo
        if [[ -n "$results" ]]; then
            while IFS=$'\t' read -r name version desc; do
                printf "  %-20s %-10s %s\n" "$name" "$version" "$desc"
            done <<< "$results"
        fi
        return 0
    fi

    if [[ -n "$filter_author" ]]; then
        local results
        if ! results=$(jq -r --arg pattern "$filter_author" '
            ("" | test($pattern; "i")) as $valid_pattern
            | .cartridges | to_entries[] | select(.value.author | test($pattern; "i"))
            | "\(.key)\t\(.value.version)\t\(.value.description)"
        ' "$BASHCMDR_REGISTRY_INDEX" 2>/dev/null); then
            __bashcmdr_error "Invalid author search pattern or registry data"
            return 1
        fi
        echo "=== Cartridges by author: $filter_author ==="
        echo
        if [[ -n "$results" ]]; then
            while IFS=$'\t' read -r name version desc; do
                printf "  %-20s %-10s %s\n" "$name" "$version" "$desc"
            done <<< "$results"
        fi
        return 0
    fi

    # Default: keyword search
    if [[ -z "$keyword" ]]; then
        echo "=== Available Cartridges ==="
    else
        echo "=== Search Results: $keyword ==="
    fi
    echo

    local results
    if ! results=$(bashcmdr_search_cartridges "$keyword"); then
        __bashcmdr_error "Search failed: invalid pattern or registry data"
        return 1
    fi

    if [[ -z "$results" ]]; then
        echo "No cartridges found"
        return 0
    fi

    printf "  %-20s %-10s %s\n" "NAME" "VERSION" "DESCRIPTION"
    printf "  %-20s %-10s %s\n" "----" "-------" "-----------"

    while IFS=$'\t' read -r name version desc; do
        local status
        status=$(bashcmdr_get_cartridge_status "$name")
        case "$status" in
            active)     status=" [active]" ;;
            inactive)   status=" [inactive]" ;;
            quarantine) status=" [quarantine]" ;;
            broken)     status=" [broken]" ;;
            installed)  status=" [installed]" ;;
            *)          status="" ;;
        esac
        printf "  %-20s %-10s %s%s\n" "$name" "$version" "$desc" "$status"
    done <<< "$results"
}

# --- Cartridge: Analysis ---

cartridge_deps_cmd() {
    __bashcmdr_dependency_inspection deps "${1-}"
}

cartridge_plan_cmd() {
    local cartridge="$1"

    echo "=== Activation Plan: $cartridge ==="

    if bashcmdr_resolve_dependencies "$cartridge"; then
        echo "  Activation order:"
        local i=1
        local cart
        for cart in "${BASHCMDR_ACTIVATION_ORDER[@]}"; do
            echo "    $i. $cart"
            ((i++))
        done
    else
        echo "  Failed to resolve dependencies"
        return 1
    fi
}

cartridge_graph_cmd() {
    __bashcmdr_dependency_inspection graph "${1-}"
}

cartridge_why_cmd() {
    __bashcmdr_dependency_inspection why "${1-}"
}

cartridge_diagnose_cmd() {
    local cartridge="${1-}"
    __bashcmdr_validate_cartridge_name "$cartridge" || return 1

    local __bcm_diagnose_root="${BASHCMDR_ROOT:-${BASHCMDR_ROOT_DIR:-}}"
    if [[ -z "$__bcm_diagnose_root" || ! -f "$__bcm_diagnose_root/cartridges/$cartridge/main.bashcmdr" ]]; then
        __bashcmdr_error "Cartridge '$cartridge' is not installed"
        __bashcmdr_info "Install from a trusted source: bashcmdr cartridge install $cartridge --from <trusted-git-source> (name-only lookup needs a usable registry index)"
        return 1
    fi
    printf '=== Diagnosing: %s ===\n\n' "$cartridge"
    __bashcmdr_cartridge_call "$cartridge" diagnose
}

# ═══════════════════════════════════════════════════════════════
#  Registry Commands — bcm registry <verb>
# ═══════════════════════════════════════════════════════════════

registry_dispatch() {
    local verb="${1:-}"
    shift 2>/dev/null || true

    if [[ -z "$verb" || "$verb" =~ ^(-h|--help|help)$ ]]; then
        help_registry
        return 0
    fi

    # Intercept --help/-h on any verb: bcm registry <verb> --help
    if [[ "${1:-}" =~ ^(-h|--help)$ ]]; then
        help_verb registry "$verb"
        return
    fi

    case "$verb" in
        sync)
            # TODO: Phase 2
            __bashcmdr_error "bcm registry sync is not yet implemented"
            __bashcmdr_info "This feature is planned for Phase 2"
            return 1
            ;;
        list)
            registry_list_cmd
            ;;
        status)
            registry_status_cmd
            ;;
        *)
            __bashcmdr_error "Unknown registry verb: $verb"
            __bashcmdr_info "Try: bcm help registry"
            return 1
            ;;
    esac
}

registry_list_cmd() {
    bashcmdr_load_registry_index || return 1

    echo "=== Registry Cartridges ==="
    echo

    local results
    results=$(bashcmdr_search_cartridges "")

    if [[ -z "$results" ]]; then
        echo "  Registry is empty"
        return 0
    fi

    printf "  %-20s %-10s %s\n" "NAME" "VERSION" "DESCRIPTION"
    printf "  %-20s %-10s %s\n" "----" "-------" "-----------"

    while IFS=$'\t' read -r name version desc; do
        printf "  %-20s %-10s %s\n" "$name" "$version" "$desc"
    done <<< "$results"
}

registry_status_cmd() {
    echo "=== Registry Status ==="
    echo

    local index_file="$BASHCMDR_REGISTRY_INDEX"

    if [[ ! -f "$index_file" ]]; then
        echo "  Status:    No registry index found"
        echo "  Registry synchronization is not implemented."
        echo "  Install:   bcm cartridge install <name> --from <trusted-git-source>"
        return 0
    fi

    if ! jq -es 'length == 1 and (.[0] | type) == "object" and (.[0].cartridges | type) == "object"' "$index_file" >/dev/null 2>&1; then
        __bashcmdr_error "Invalid registry index: $index_file"
        return 1
    fi

    local reg_version reg_url timestamp cart_count
    reg_version=$(jq -r '.version // "unknown"' "$index_file" 2>/dev/null)
    reg_url=$(jq -r '.registry_url // "not set"' "$index_file" 2>/dev/null)
    timestamp=$(jq -r '.timestamp // "unknown"' "$index_file" 2>/dev/null)
    cart_count=$(jq -r '.cartridges | length' "$index_file" 2>/dev/null)

    printf "  %-16s %s\n" "Index version:" "$reg_version"
    printf "  %-16s %s\n" "Registry URL:" "$reg_url"
    printf "  %-16s %s\n" "Last updated:" "$timestamp"
    printf "  %-16s %s\n" "Cartridges:" "$cart_count"

    local index_date now age_days stat_path="$index_file"
    [[ "$stat_path" != -* ]] || stat_path="./$stat_path"
    # GNU/BusyBox and BSD forms are capabilities, not platform guesses.
    # Bound decimal text before any arithmetic, including failed producers.
    if index_date=$(stat -c %Y "$stat_path" 2>/dev/null) &&
       [[ "$index_date" =~ ^(0|[1-9][0-9]{0,11})$ ]]; then
        :
    elif index_date=$(stat -f %m "$stat_path" 2>/dev/null) &&
         [[ "$index_date" =~ ^(0|[1-9][0-9]{0,11})$ ]]; then
        :
    else
        printf '  Index age: unavailable (stat mtime unsupported or invalid)\n'
        return 0
    fi
    if ! now=$(date +%s 2>/dev/null) || [[ ! "$now" =~ ^(0|[1-9][0-9]{0,11})$ ]]; then
        printf '  Index age: unavailable (date epoch unsupported or invalid)\n'
        return 0
    fi
    if ((index_date > now)); then
        printf '  Index age: unavailable (mtime is in the future)\n'
        return 0
    fi
    age_days=$(( (now - index_date) / 86400 ))
    if ((age_days > 7)); then
        echo
        echo "  ⚠ Index is $age_days days old."
        echo "  Registry synchronization is not implemented; verify index entries before name-only installation."
        echo "  Install:   bcm cartridge install <name> --from <trusted-git-source>"
    fi
}

# ═══════════════════════════════════════════════════════════════
#  Main Dispatch
# ═══════════════════════════════════════════════════════════════

main() {
    local first_arg="${1:-help}"
    shift 2>/dev/null || true
    local RESOLVED_ARGS
    if resolve_alias "$first_arg" "$@"; then
        # Alias was resolved — re-extract noun and args
        first_arg="${RESOLVED_ARGS[0]}"
        set -- "${RESOLVED_ARGS[@]:1}"
    else
        local resolution_status=$?
        ((resolution_status == 1)) || return 1
    fi

    # Help flags are reserved command tokens and never execute the operation.
    if [[ "$first_arg" == -h || "$first_arg" == --help ]]; then help_top; return; fi
    if [[ "$first_arg" == help ]]; then help_cmd "$@"; return; fi
    local help_requested=0 argument
    for argument in "$@"; do
        case "$argument" in -h|--help) help_requested=1 ;; esac
    done
    if ((help_requested)); then
        case "$first_arg" in
            console|cartridge|registry)
                case "${1-}" in
                    ''|help|-h|--help) help_cmd "$first_arg" ;;
                    *) help_cmd "$first_arg" "$1" ;;
                esac ;;
            alias)
                case "${1-}" in
                    list|remove) help_verb alias "$1" ;;
                    *) help_alias ;;
                esac ;;
            *) help_cmd "$first_arg" ;;
        esac
        return
    fi
    case "$first_arg" in
        console|cartridge|registry)
            if (($# == 0)); then help_cmd "$first_arg"; return; fi
            if [[ "$1" == help ]]; then shift; help_cmd "$first_arg" "$@"; return; fi ;;
    esac

    # Shortcut inspection/explicit installation works without writable runtime
    # storage, including when reached through a command alias.
    if [[ "$first_arg" == console && ${1-} == shortcut ]]; then
        console_dispatch "$@"
        return $?
    fi
    # Admit tools before runtime creation, repair, fetching or hook effects.
    __bashcmdr_require_operation_tools "$first_arg" "$@" || return 1
    # Other commands retain explicit runtime initialization.
    mkdir -p -- "$BASHCMDR_INSTALLED_DIR" || return 1
    __bashcmdr_sync_physical_state || return 1

    # Dispatch by noun or firmware command
    case "$first_arg" in
        # Nouns — two-level dispatch
        console)
            console_dispatch "$@"
            ;;
        cartridge)
            cartridge_dispatch "$@"
            ;;
        registry)
            registry_dispatch "$@"
            ;;

        # Firmware commands — no noun needed
        version)
            version_cmd
            ;;
        help)
            help_cmd "$@"
            ;;
        doctor)
            doctor_cmd
            ;;
        alias)
            alias_cmd "$@"
            ;;

        # Unknown
        *)
            __bashcmdr_error "Unknown command: $first_arg"
            __bashcmdr_info "Try: bcm help"
            return 1
            ;;
    esac
}

# Execute if called directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
